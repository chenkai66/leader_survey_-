! ============================================================
! Study 3: Multilevel Confirmatory Factor Analysis (MCFA)
! Leadership Styles, Envy, and Subordinate Outcomes
! ============================================================
! Note: Run each model section separately in Mplus.
! Data file: study3_mcfa.dat (exported from final_merged_analysis_data.xlsx)
! Variables: CLID AUT1-AUT6 EMPP1-EMPP4 BEN1-BEN5 MAL1-MAL5 THRP1-THRP4
! ============================================================

! ============================================================
! MODEL 1: FIVE-FACTOR MODEL (Hypothesized)
! Factors: Autocratic, Empowering, Benign Envy, Malicious Envy, Thriving
! ============================================================

TITLE: Study 3 MCFA - Hypothesized Five-Factor Model;

DATA:
  FILE IS study3_mcfa.dat;

VARIABLE:
  NAMES ARE
    CLID
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  USEVARIABLES ARE
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  CLUSTER IS CLID;

  MISSING ARE ALL (-999);

ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = MLR;
  ITERATIONS = 10000;
  H1ITERATIONS = 10000;

MODEL:

  %WITHIN%

    AUTW BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6;
    EMPW BY EMPP1 EMPP2 EMPP3 EMPP4;
    BENW BY BEN1 BEN2 BEN3 BEN4 BEN5;
    MALW BY MAL1 MAL2 MAL3 MAL4 MAL5;
    THRW BY THRP1 THRP2 THRP3 THRP4;

  %BETWEEN%

    AUTB BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6;
    EMPB BY EMPP1 EMPP2 EMPP3 EMPP4;
    BENB BY BEN1 BEN2 BEN3 BEN4 BEN5;
    MALB BY MAL1 MAL2 MAL3 MAL4 MAL5;
    THRB BY THRP1 THRP2 THRP3 THRP4;

OUTPUT:
  SAMPSTAT STANDARDIZED TECH1 TECH4;


! ============================================================
! MODEL 2: FOUR-FACTOR MODEL
! Benign Envy and Malicious Envy combined into single ENVY factor
! ============================================================

TITLE: Study 3 MCFA - Four-Factor Model (BEN + MAL Combined);

DATA:
  FILE IS study3_mcfa.dat;

VARIABLE:
  NAMES ARE
    CLID
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  USEVARIABLES ARE
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  CLUSTER IS CLID;

  MISSING ARE ALL (-999);

ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = MLR;
  ITERATIONS = 10000;
  H1ITERATIONS = 10000;

MODEL:

  %WITHIN%

    AUTW BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6;
    EMPW BY EMPP1 EMPP2 EMPP3 EMPP4;
    ENVYW BY BEN1 BEN2 BEN3 BEN4 BEN5
            MAL1 MAL2 MAL3 MAL4 MAL5;
    THRW BY THRP1 THRP2 THRP3 THRP4;

  %BETWEEN%

    AUTB BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6;
    EMPB BY EMPP1 EMPP2 EMPP3 EMPP4;
    ENVYB BY BEN1 BEN2 BEN3 BEN4 BEN5
            MAL1 MAL2 MAL3 MAL4 MAL5;
    THRB BY THRP1 THRP2 THRP3 THRP4;

OUTPUT:
  SAMPSTAT STANDARDIZED TECH1 TECH4;


! ============================================================
! MODEL 3: THREE-FACTOR MODEL
! Autocratic + Empowering combined, BEN + MAL combined, Thriving
! ============================================================

TITLE: Study 3 MCFA - Three-Factor Model;

DATA:
  FILE IS study3_mcfa.dat;

VARIABLE:
  NAMES ARE
    CLID
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  USEVARIABLES ARE
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  CLUSTER IS CLID;

  MISSING ARE ALL (-999);

ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = MLR;
  ITERATIONS = 10000;
  H1ITERATIONS = 10000;

MODEL:

  %WITHIN%

    LEADW BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
             EMPP1 EMPP2 EMPP3 EMPP4;
    ENVYW BY BEN1 BEN2 BEN3 BEN4 BEN5
             MAL1 MAL2 MAL3 MAL4 MAL5;
    THRW BY THRP1 THRP2 THRP3 THRP4;

  %BETWEEN%

    LEADB BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
             EMPP1 EMPP2 EMPP3 EMPP4;
    ENVYB BY BEN1 BEN2 BEN3 BEN4 BEN5
             MAL1 MAL2 MAL3 MAL4 MAL5;
    THRB BY THRP1 THRP2 THRP3 THRP4;

OUTPUT:
  SAMPSTAT STANDARDIZED TECH1 TECH4;


! ============================================================
! MODEL 4: TWO-FACTOR MODEL
! All predictors (AUT + EMP + BEN + MAL) vs All outcomes (THR)
! ============================================================

TITLE: Study 3 MCFA - Two-Factor Model;

DATA:
  FILE IS study3_mcfa.dat;

VARIABLE:
  NAMES ARE
    CLID
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  USEVARIABLES ARE
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  CLUSTER IS CLID;

  MISSING ARE ALL (-999);

ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = MLR;
  ITERATIONS = 10000;
  H1ITERATIONS = 10000;

MODEL:

  %WITHIN%

    PREDW BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
             EMPP1 EMPP2 EMPP3 EMPP4
             BEN1 BEN2 BEN3 BEN4 BEN5
             MAL1 MAL2 MAL3 MAL4 MAL5;
    OUTW BY THRP1 THRP2 THRP3 THRP4;

  %BETWEEN%

    PREDB BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
             EMPP1 EMPP2 EMPP3 EMPP4
             BEN1 BEN2 BEN3 BEN4 BEN5
             MAL1 MAL2 MAL3 MAL4 MAL5;
    OUTB BY THRP1 THRP2 THRP3 THRP4;

OUTPUT:
  SAMPSTAT STANDARDIZED TECH1 TECH4;



! ============================================================
! MODEL 5: SINGLE-FACTOR MODEL
! All 24 indicators load on one general factor
! ============================================================

TITLE: Study 3 MCFA - Single-Factor Model;

DATA:
  FILE IS study3_mcfa.dat;

VARIABLE:
  NAMES ARE
    CLID
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  USEVARIABLES ARE
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  CLUSTER IS CLID;

  MISSING ARE ALL (-999);

ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = MLR;
  ITERATIONS = 10000;
  H1ITERATIONS = 10000;

MODEL:

  %WITHIN%

    GENW BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
            EMPP1 EMPP2 EMPP3 EMPP4
            BEN1 BEN2 BEN3 BEN4 BEN5
            MAL1 MAL2 MAL3 MAL4 MAL5
            THRP1 THRP2 THRP3 THRP4;

  %BETWEEN%

    GENB BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
            EMPP1 EMPP2 EMPP3 EMPP4
            BEN1 BEN2 BEN3 BEN4 BEN5
            MAL1 MAL2 MAL3 MAL4 MAL5
            THRP1 THRP2 THRP3 THRP4;

OUTPUT:
  SAMPSTAT STANDARDIZED TECH1 TECH4;



! ============================================================
! APPENDIX: SINGLE-CONSTRUCT CFA WITH CLUSTER ADJUSTMENT
! Used for master Table A1 / A2 (single-construct CFA): each
! construct fit separately with TYPE = COMPLEX to obtain cluster-
! robust SEs that account for follower-within-leader nesting (per
! client spec: measurement appendix single-construct CFAs must
! consider nested data / cluster adjustment).
! Re-run for each construct by changing BY statement and
! USEVARIABLES list to that construct items.
! ============================================================

TITLE: Study 3 Single-Construct CFA - Autocratic Leadership;

DATA:
  FILE IS study3_mcfa.dat;

VARIABLE:
  NAMES ARE
    CLID
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  USEVARIABLES ARE
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6;

  CLUSTER IS CLID;

  MISSING ARE ALL (-999);

ANALYSIS:
  TYPE = COMPLEX;
  ESTIMATOR = MLR;

MODEL:
  AUT BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6;

OUTPUT:
  SAMPSTAT STANDARDIZED TECH1;

! ------------------------------------------------------------
! For other single-construct CFAs (Empowering parcels /
! Narcissism / Power Distance / Benign Envy / Malicious Envy /
! Thriving parcels / Self-rated OCBS / Self-rated CWBS /
! Leader-rated OCBS / Leader-rated CWBS), repeat the above block
! changing:
!   - TITLE
!   - USEVARIABLES (the items for that construct)
!   - The BY statement (factor name + same items)
! All keep TYPE = COMPLEX with CLUSTER IS CLID for cluster-robust SE.
! ============================================================

! ============================================================
! DATA PREPARATION NOTES
! ============================================================
! To create study3_mcfa.dat from final_merged_analysis_data.xlsx:
! 1. Export only CLID, AUT1-AUT6, EMPP1-EMPP4, BEN1-BEN5, MAL1-MAL5, THRP1-THRP4
! 2. Replace missing values with -999
! 3. Save as space-delimited .dat file
! 4. N = 361 followers nested within 79 leaders (clusters)
!
! Parcel definitions (theoretical, NOT random):
!   EMPP1 = mean(EMP1, EMP2, EMP3)
!   EMPP2 = mean(EMP4, EMP5, EMP6)
!   EMPP3 = mean(EMP7, EMP8, EMP9)
!   EMPP4 = mean(EMP10, EMP11, EMP12)
!   THRP1 = mean(THR1, THR3, R_THR5)
!   THRP2 = mean(THR2, THR4)
!   THRP3 = mean(THR6, THR8, R_THR10)
!   THRP4 = mean(THR7, THR9)
! ============================================================
