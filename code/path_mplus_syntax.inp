! ============================================================
! Study 3: Two-Level Path Model — Simultaneous Estimation
! v2: matches customer's exact Mplus spec (path修.out, 2026-06-04)
!
! Variable order in study3_path.dat (auto-generated by
! code/export_path_dat.py — re-run if data changes):
!   CLID FAGE GMALE TEN INTF AUT EMP NARC PD T1THR
!   BE ME T3THR OCBSL CWBSL OCBSF CWBSF
!
! Customer's spec used Gender_Female (1=female) and _C suffix
! pre-centered vars. This .inp does the centering inside Mplus
! (CENTERING = GRANDMEAN) and uses GMALE (1=male). Equivalent
! results, cleaner pipeline.
! ============================================================

TITLE: Study 3 Simultaneous Two-Level Path Model with Interactive Moderation;

DATA:
  FILE = study3_path.dat;

VARIABLE:
  NAMES =
    CLID FAGE GMALE TEN INTF
    AUT EMP NARC PD T1THR
    BE ME T3THR OCBSL CWBSL OCBSF CWBSF;

  USEVARIABLES =
    BE ME T3THR OCBSL CWBSL
    AUT EMP NARC PD
    FAGE GMALE TEN INTF T1THR
    ALNARC ELNARC ALPD ELPD;

  CLUSTER = CLID;
  MISSING = ALL (-999);
  CENTERING = GRANDMEAN (AUT EMP NARC PD FAGE TEN INTF T1THR);

  WITHIN =
    AUT EMP NARC PD
    FAGE GMALE TEN INTF T1THR
    ALNARC ELNARC ALPD ELPD;

DEFINE:
  ALNARC = AUT * NARC;
  ELNARC = EMP * NARC;
  ALPD   = AUT * PD;
  ELPD   = EMP * PD;

ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = MLR;

MODEL:

  %WITHIN%

    ! Mediator equations: BE/ME ~ X + W + 4 interactions
    BE ON FAGE GMALE TEN INTF
          AUT EMP NARC PD
          ALNARC ELNARC ALPD ELPD;

    ME ON FAGE GMALE TEN INTF
          AUT EMP NARC PD
          ALNARC ELNARC ALPD ELPD;

    ! Outcome equations (joint): Y ~ M + X + W + controls
    T3THR ON FAGE GMALE TEN INTF T1THR
             AUT EMP BE ME NARC PD;

    OCBSL ON FAGE GMALE TEN INTF
             AUT EMP BE ME NARC PD;

    CWBSL ON FAGE GMALE TEN INTF
             AUT EMP BE ME NARC PD;

    ! Outcome residual covariances (joint estimation)
    T3THR WITH OCBSL CWBSL;
    OCBSL WITH CWBSL;

  %BETWEEN%

    ! Random intercepts only (level-2 variances)
    BE ME T3THR OCBSL CWBSL;

OUTPUT:
  SAMPSTAT STANDARDIZED CINTERVAL TECH1 TECH4;

! ============================================================
! VARIANT A — TWOLEVEL RANDOM (random M->Y slopes)
! Try this if you want to see if random slopes change M->Y;
! requires ALGORITHM = INTEGRATION when combined with XWITH.
!
! ANALYSIS:  TYPE = TWOLEVEL RANDOM;
! MODEL:
!   %WITHIN%
!     sBE_THR | T3THR ON BE;
!     sME_THR | T3THR ON ME;
!     sBE_OCB | OCBSL ON BE;
!     sME_OCB | OCBSL ON ME;
!     sBE_CWB | CWBSL ON BE;
!     sME_CWB | CWBSL ON ME;
!     ...
!   %BETWEEN%
!     sBE_THR sME_THR sBE_OCB sME_OCB sBE_CWB sME_CWB;
! ============================================================
