/* Mplus Syntax for Multilevel CFA (MCFA) Analysis */

/* Five-Factor Model */
TITLE: Study 3 MCFA - Hypothesized Five-Factor Model;

DATA:
  FILE IS study3_mcfa.dat;

VARIABLE:
  NAMES ARE
    CLID
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  USEVARIABLES ARE
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  CLUSTER IS CLID;

  MISSING ARE ALL (-999);

ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = MLR;
  ITERATIONS = 10000;
  H1ITERATIONS = 10000;

MODEL:

  %WITHIN%

    AUTW BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6;
    EMPW BY EMPP1 EMPP2 EMPP3 EMPP4;
    BENW BY BEN1 BEN2 BEN3 BEN4 BEN5;
    MALW BY MAL1 MAL2 MAL3 MAL4 MAL5;
    THRW BY THRP1 THRP2 THRP3 THRP4;

  %BETWEEN%

    AUTB BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6;
    EMPB BY EMPP1 EMPP2 EMPP3 EMPP4;
    BENB BY BEN1 BEN2 BEN3 BEN4 BEN5;
    MALB BY MAL1 MAL2 MAL3 MAL4 MAL5;
    THRB BY THRP1 THRP2 THRP3 THRP4;

OUTPUT:
  SAMPSTAT STANDARDIZED TECH1 TECH4;


/* Four-Factor Model (Benign and Malicious Envy Combined) */
TITLE: Study 3 MCFA - Model 1 Four-Factor Model: Benign and Malicious Envy Combined;

DATA:
  FILE IS study3_mcfa.dat;

VARIABLE:
  NAMES ARE
    CLID
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  USEVARIABLES ARE
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  CLUSTER IS CLID;

  MISSING ARE ALL (-999);

ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = MLR;
  ITERATIONS = 10000;
  H1ITERATIONS = 10000;

MODEL:

  %WITHIN%

    AUTW BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6;
    EMPW BY EMPP1 EMPP2 EMPP3 EMPP4;
    ENVYW BY BEN1 BEN2 BEN3 BEN4 BEN5
            MAL1 MAL2 MAL3 MAL4 MAL5;
    THRW BY THRP1 THRP2 THRP3 THRP4;

  %BETWEEN%

    AUTB BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6;
    EMPB BY EMPP1 EMPP2 EMPP3 EMPP4;
    ENVYB BY BEN1 BEN2 BEN3 BEN4 BEN5
            MAL1 MAL2 MAL3 MAL4 MAL5;
    THRB BY THRP1 THRP2 THRP3 THRP4;

OUTPUT:
  SAMPSTAT STANDARDIZED TECH1 TECH4;


/* Three-Factor Model (Leadership factors combined) */
TITLE: Study 3 MCFA - Three-Factor Model: Leadership Factors Combined;

DATA:
  FILE IS study3_mcfa.dat;

VARIABLE:
  NAMES ARE
    CLID
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  USEVARIABLES ARE
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  CLUSTER IS CLID;

  MISSING ARE ALL (-999);

ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = MLR;
  ITERATIONS = 10000;
  H1ITERATIONS = 10000;

MODEL:

  %WITHIN%

    LEADW BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
           EMPP1 EMPP2 EMPP3 EMPP4;
    ENVYW BY BEN1 BEN2 BEN3 BEN4 BEN5
            MAL1 MAL2 MAL3 MAL4 MAL5;
    THRW BY THRP1 THRP2 THRP3 THRP4;

  %BETWEEN%

    LEADB BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
            EMPP1 EMPP2 EMPP3 EMPP4;
    ENVYB BY BEN1 BEN2 BEN3 BEN4 BEN5
            MAL1 MAL2 MAL3 MAL4 MAL5;
    THRB BY THRP1 THRP2 THRP3 THRP4;

OUTPUT:
  SAMPSTAT STANDARDIZED TECH1 TECH4;


/* Two-Factor Model (Envy and Thriving only) */
TITLE: Study 3 MCFA - Two-Factor Model: Envy and Thriving;

DATA:
  FILE IS study3_mcfa.dat;

VARIABLE:
  NAMES ARE
    CLID
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  USEVARIABLES ARE
    AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
    EMPP1 EMPP2 EMPP3 EMPP4
    BEN1 BEN2 BEN3 BEN4 BEN5
    MAL1 MAL2 MAL3 MAL4 MAL5
    THRP1 THRP2 THRP3 THRP4;

  CLUSTER IS CLID;

  MISSING ARE ALL (-999);

ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = MLR;
  ITERATIONS = 10000;
  H1ITERATIONS = 10000;

MODEL:

  %WITHIN%

    ENVYW BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
            EMPP1 EMPP2 EMPP3 EMPP4
            BEN1 BEN2 BEN3 BEN4 BEN5
            MAL1 MAL2 MAL3 MAL4 MAL5;
    THRW BY THRP1 THRP2 THRP3 THRP4;

  %BETWEEN%

    ENVYB BY AUT1 AUT2 AUT3 AUT4 AUT5 AUT6
            EMPP1 EMPP2 EMPP3 EMPP4
            BEN1 BEN2 BEN3 BEN4 BEN5
            MAL1 MAL2 MAL3 MAL4 MAL5;
    THRB BY THRP1 THRP2 THRP3 THRP4;

OUTPUT:
  SAMPSTAT STANDARDIZED TECH1 TECH4;


/* Null Model for ICC Calculation */
TITLE: Study 3 Null Model for ICC Calculation;

DATA:
  FILE IS study3_null_model.dat;

VARIABLE:
  NAMES ARE
    CLID
    THRIVING_SCORE;

  CLUSTER IS CLID;

  MISSING ARE ALL (-999);

ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = MLR;

MODEL:

  %WITHIN%
    THRIVING_SCORE;

  %BETWEEN%
    THRIVING_SCORE;

OUTPUT:
  SAMPSTAT STANDARDIZED TECH1 TECH4;


/* Main Multilevel Model with Centering */
TITLE: Study 3 Main Multilevel Model with Grand-Mean Centering;

DATA:
  FILE IS study3_main_model.dat;

VARIABLE:
  NAMES ARE
    CLID
    AUTO_LEAD_C    /* Grand-mean centered autocratic leadership */
    EMP_LEAD_C     /* Grand-mean centered empowering leadership */
    NARCISSISM_C   /* Grand-mean centered narcissism */
    PDISTANCE_C    /* Grand-mean centered power distance */
    FOL_AGE_C      /* Grand-mean centered follower age */
    TENURE_C       /* Grand-mean centered tenure with leader */
    INTERACTFREQ_C /* Grand-mean centered interaction frequency */
    T1_THRIVE_C    /* Grand-mean centered T1 thriving */
    BENIGN_ENVY
    MALICIOUS_ENVY
    THRIVING_T2
    THRIVING_T3
    OCBS           /* Other-condemning behavior scale */
    CWBS           /* Counterproductive work behavior scale */
    HELPLEADER     /* Helping behavior toward leader */
    AGE
    TENURE_WITH_LEADER
    INTERACTION_FREQ
    WORK_YEARS;

  USEVARIABLES ARE
    AUTO_LEAD_C EMP_LEAD_C NARCISSISM_C PDISTANCE_C
    FOL_AGE_C TENURE_C INTERACTFREQ_C T1_THRIVE_C
    BENIGN_ENVY MALICIOUS_ENVY THRIVING_T2 THRIVING_T3
    OCBS CWBS HELPLEADER;

  CLUSTER IS CLID;

  MISSING ARE ALL (-999);

ANALYSIS:
  TYPE = TWOLEVEL RANDOM;
  ESTIMATOR = MLR;
  BOOTSTRAP = 1000;

MODEL:

  %WITHIN%
    /* Mediation model: Leadership -> Envy -> Outcomes */
    BENIGN_ENVY ON AUTO_LEAD_C EMP_LEAD_C;
    MALICIOUS_ENVY ON AUTO_LEAD_C EMP_LEAD_C;

    THRIVING_T3 ON AUTO_LEAD_C EMP_LEAD_C
                  BENIGN_ENVY MALICIOUS_ENVY T1_THRIVE_C;

    OCBS ON AUTO_LEAD_C EMP_LEAD_C
         BENIGN_ENVY MALICIOUS_ENVY;

    CWBS ON AUTO_LEAD_C EMP_LEAD_C
         BENIGN_ENVY MALICIOUS_ENVY;

    HELPLEADER ON AUTO_LEAD_C EMP_LEAD_C
                 BENIGN_ENVY MALICIOUS_ENVY;

    /* Allow errors to correlate */
    BENIGN_ENVY WITH MALICIOUS_ENVY;
    THRIVING_T2 WITH THRIVING_T3;
    OCBS WITH CWBS;

  %BETWEEN%
    /* Between-level effects */
    BENIGN_ENVY ON AUTO_LEAD_C EMP_LEAD_C;
    MALICIOUS_ENVY ON AUTO_LEAD_C EMP_LEAD_C;

    THRIVING_T3 ON AUTO_LEAD_C EMP_LEAD_C;

    OCBS ON AUTO_LEAD_C EMP_LEAD_C;
    CWBS ON AUTO_LEAD_C EMP_LEAD_C;

MODEL CONSTRAINT:
  /* Define indirect effects for bootstrap confidence intervals */
  NEW(indir_auto_thrive indir_emp_thrive
      indir_auto_ocbs indir_emp_ocbs
      indir_auto_cwbs indir_emp_cwbs);

  /* Indirect effect through envy for thriving */
  indir_auto_thrive = (AUTO_LEAD_C_ON_AUTO_LEAD_C) *
                      (THRIVING_T3_ON_BENIGN_ENVY*BENIGN_ENVY_ON_AUTO_LEAD_C +
                       THRIVING_T3_ON_MALICIOUS_ENVY*MALICIOUS_ENVY_ON_AUTO_LEAD_C);

  indir_emp_thrive = (EMP_LEAD_C_ON_EMP_LEAD_C) *
                     (THRIVING_T3_ON_BENIGN_ENVY*BENIGN_ENVY_ON_EMP_LEAD_C +
                      THRIVING_T3_ON_MALICIOUS_ENVY*MALICIOUS_ENVY_ON_EMP_LEAD_C);

  /* Indirect effects for OCBS */
  indir_auto_ocbs = (AUTO_LEAD_C_ON_AUTO_LEAD_C) *
                    (OCBS_ON_BENIGN_ENVY*BENIGN_ENVY_ON_AUTO_LEAD_C +
                     OCBS_ON_MALICIOUS_ENVY*MALICIOUS_ENVY_ON_AUTO_LEAD_C);

  indir_emp_ocbs = (EMP_LEAD_C_ON_EMP_LEAD_C) *
                   (OCBS_ON_BENIGN_ENVY*BENIGN_ENVY_ON_EMP_LEAD_C +
                    OCBS_ON_MALICIOUS_ENVY*MALICIOUS_ENVY_ON_EMP_LEAD_C);

  /* Indirect effects for CWBS */
  indir_auto_cwbs = (AUTO_LEAD_C_ON_AUTO_LEAD_C) *
                    (CWBS_ON_BENIGN_ENVY*BENIGN_ENVY_ON_AUTO_LEAD_C +
                     CWBS_ON_MALICIOUS_ENVY*MALICIOUS_ENVY_ON_AUTO_LEAD_C);

  indir_emp_cwbs = (EMP_LEAD_C_ON_EMP_LEAD_C) *
                   (CWBS_ON_BENIGN_ENVY*BENIGN_ENVY_ON_EMP_LEAD_C +
                    CWBS_ON_MALICIOUS_ENVY*MALICIOUS_ENVY_ON_EMP_LEAD_C);

OUTPUT:
  SAMPSTAT STANDARDIZED CINTERVAL(BCBOOTSTRAP);